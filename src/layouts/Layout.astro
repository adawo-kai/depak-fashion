---
import '../styles/global.css';

const title = 'DEPAK.fashion — одежда для горных походов, Бишкек';
const description = 'Бишкекский бренд одежды для горных походов: пуховые парки, штормовки, мериносовое термобельё. Доставка по Кыргызстану.';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e161a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;800&family=Playfair+Display:ital,wght@0,600;1,500&family=Caveat:wght@600&family=Manrope:wght@300;400;500;600&display=swap&subset=cyrillic"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
